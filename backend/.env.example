# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env   (Windows: copy .env.example .env)
# .env dosyasını ASLA git'e eklemeyin.

# --- Veritabanı ---
# Geliştirme (SQLite, kurulum gerektirmez):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL örneği (requirements.txt içinde psycopg2-binary satırını açın):
# DATABASE_URL=postgresql+psycopg2://kullanici:sifre@localhost:5432/afet_hasar

# --- Güvenlik ---
# En az 32 karakter. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=BURAYA-EN-AZ-32-KARAKTERLIK-RASTGELE-DEGER-YAZIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Dosya depolama ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# --- CORS (frontend adresleri, virgülle ayırın) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
