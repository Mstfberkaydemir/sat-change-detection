{
  "info": {
    "name": "Afet Hasar Tespiti API",
    "description": "Swagger: {{baseUrl}}/docs  |  OpenAPI JSON: {{baseUrl}}/openapi.json\nSıra: Register -> Login -> Create analysis -> Upload images -> Run -> Download mask",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "analysisId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"berkay\",\n  \"email\": \"berkay@example.com\",\n  \"password\": \"gizli-sifre-1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 veya 409 (zaten kayıtlı)', () => pm.expect([201, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "berkay",
              "type": "text"
            },
            {
              "key": "password",
              "value": "gizli-sifre-1",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create analysis",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/analyses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analyses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Hatay deprem sonrası analiz\",\n  \"region_name\": \"Hatay\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('analysisId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List analyses",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/analyses?skip=0&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analyses"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get analysis",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/analyses/{{analysisId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analyses",
            "{{analysisId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload T1/T2 images",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/analyses/{{analysisId}}/images",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analyses",
            "{{analysisId}}",
            "images"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "t1",
              "type": "file",
              "src": []
            },
            {
              "key": "t2",
              "type": "file",
              "src": []
            },
            {
              "key": "crs_projection",
              "value": "EPSG:4326",
              "type": "text",
              "disabled": true
            },
            {
              "key": "bounding_box",
              "value": "36.1,36.0,36.3,36.3",
              "type": "text",
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK (T1 ve T2 dosyalarını seçmeyi unutmayın)', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Run analysis",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/analyses/{{analysisId}}/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analyses",
            "{{analysisId}}",
            "run"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status = completed', () => pm.expect(pm.response.json().status).to.eql('completed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Download mask (PNG)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/analyses/{{analysisId}}/mask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analyses",
            "{{analysisId}}",
            "mask"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete analysis",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/analyses/{{analysisId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analyses",
            "{{analysisId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}